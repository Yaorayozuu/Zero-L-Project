# Environment variables — Netflix QR Web (mode kode akses, tanpa DB)

# Kode akses yang bisa dipakai user masuk. Pisah pakai koma.
# Contoh: "RAHASIA1,RAHASIA2,TEMAN10"  -> 3 kode valid.
# Kasih kode ini ke orang yg boleh pakai. Hapus dari list = kode mati.
ACCESS_CODES=""

# Secret buat nandatangan cookie sesi. Min 32 karakter random.
# Bikin: openssl rand -hex 32
JWT_SECRET=""

# Worker generate (jalan di VPS/Termux, BUKAN Vercel).
WORKER_URL=""
WORKER_TOKEN=""
